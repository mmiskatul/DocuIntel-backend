# ==============================================================================
# DocuIntel Backend .gitignore - Secrets, Credentials & Build Artifacts
# ==============================================================================

# 1. Environment & Secret Configuration (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 2. Certificates, Private Keys & Tokens
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jwt
*.token
secrets.*
credentials.json
service-account*.json
client_secret*.json
firebase-adminsdk*.json

# 3. Dependencies
node_modules/

# 4. Compiled & Build Output
dist/
build/
*.tsbuildinfo

# 5. Local Storage, Uploads & Databases
uploads/
storage/
*.db
*.sqlite
*.sqlite3

# 6. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. OS & IDE Configuration
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
