---------------------------------------------------------------
# PostgreSQL connection string (Supabase pooler URL, or any PostgreSQL with the pgvector extension).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# OpenAI key used for field extraction, vision OCR fallback, embeddings and answers.
OPENAI_API_KEY=your-openai-api-key

# ---- Security ----------------------------------------------------------------
# When set, every /api request must send it (header X-API-Key). Use the same value as BACKEND_API_KEY on the website.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-long-random-string
# Websites allowed to call the API, separated by commas.
CORS_ORIGINS=http://localhost:3000

# ---- Cloudinary (optional) ---------------------------------------------------
# Originals are kept in Cloudinary while a document awaits review, and deleted when it is approved.
# Without it, originals are kept in the database instead. Use ONE of the two forms below.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#