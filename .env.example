PORT=8000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres  # required, no default
OPENAI_API_KEY=your-openai-api-key
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=100
MAX_FILES_PER_REQUEST=50
MAX_OCR_PAGES=100
MAX_INDEX_CHUNKS=200
API_KEY=change-me-long-random-string
WORKER_CONCURRENCY=3
OCR_ENGINE=auto
OCR_MIN_CONFIDENCE=0.80
STALE_JOB_SECONDS=120
MAX_INVOICES_PER_DOCUMENT=500
EXTRACTION_PARALLELISM=4
