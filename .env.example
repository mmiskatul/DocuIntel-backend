# ==============================================================================
# DocuIntel NestJS Backend Configuration (.env.example)
# ==============================================================================
PORT=8000

# 1. Supabase Credentials (Database & Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Optional: Direct PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/docuintel

# 2. Connection to the OCR & AI Microservice (ocr-model)
OCR_SERVICE_URL=http://localhost:7860

# 3. JWT Authentication (Generate via `openssl rand -hex 32` or use your Supabase Project JWT Secret)
JWT_SECRET=jwt-secret
JWT_EXPIRES_IN=7d

# 4. CORS (Allowed frontend origins, comma-separated)
CORS_ORIGINS=http://localhost:3000,https://*.pages.dev,https://*.vercel.app,*

# 5. Redis (Local fallback or Render Cloud Redis URL: rediss://...)
REDIS_URL=redis://localhost:6379/0
